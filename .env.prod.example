# ==============================================================================
# SeatSnap Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=seatsnap
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=seatsnap

# Secrets (Generate 32+ character random strings: `openssl rand -hex 32`)
JWT_SECRET=replace_with_32_char_random_jwt_secret_key
INTERNAL_API_KEY=replace_with_32_char_internal_service_key
TICKET_SIGNING_SECRET=replace_with_32_char_ticket_hmac_secret
PAYMENT_WEBHOOK_SECRET=replace_with_32_char_webhook_secret

# Business Logic
HOLD_TTL_SECONDS=300
SWEEPER_INTERVAL_SECONDS=30
MAX_SEATS_PER_BOOKING=6

# Payment Gateway Configuration
# Options: 'mock' (dev/demo) or 'razorpay' (production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / Notification Worker (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

# Public Ports & Endpoints
GATEWAY_PORT=4000
WEB_PORT=80
PUBLIC_API_URL=https://api.yourdomain.com
CORS_ORIGIN=https://yourdomain.com
